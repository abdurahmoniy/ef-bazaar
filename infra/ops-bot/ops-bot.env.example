# efBazaar ops-bot — environment file template.
#
# CI deploy avtomatik qayta yozadi: /opt/efbazaar/infra/ops-bot/.env  (chmod 600).
# Bu fayl faqat qanday maydonlar kerakligini ko'rsatish uchun repo'da qoladi.
# Barcha qiymatlar GitHub Secrets'dan `deploy.sh`'da injektsiya qilinadi.

# @EfbazaarOpsBot token from BotFather. Alohida bot — bosh @EfBazaarBot bilan
# aralashmasin (bir tokendan ikkita consumer ishlata olmaydi).
OPS_BOT_TOKEN=

# Existing supergroup id — bosh bot bilan bir xil kanal.
TELEGRAM_GROUP_CHAT_ID=

# Existing forum topic thread id — barcha /logs javoblari shu yerga tushadi.
TELEGRAM_TOPIC_LOGS=

# `docker ps --filter name=<prefix>` — begona containerlar ro'yxatga tushmasin.
CONTAINER_PREFIX=efbazaar-
