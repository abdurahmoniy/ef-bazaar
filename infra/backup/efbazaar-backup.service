[Unit]
Description=efBazaar DB backup — pg_dumpall + AES-256 + Telegram upload
Documentation=https://github.com/abdurahmoniy/ef-bazaar/tree/main/infra/backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/efbazaar/infra/backup
ExecStart=/usr/bin/env bash /opt/efbazaar/infra/backup/backup-db.sh

# NO Restart=on-failure — backup is one-shot, and any real failure already
# alerts via alert_fail() to the health topic. Retrying would upload a second
# copy of the same day's dump (user sees 2 backup messages back-to-back).
# Timer runs again next day; investigate manually if a run fails.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=efbazaar-backup

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# Private /tmp — service uchun alohida tmpfs (mktemp/split ishlashi uchun).
# Host'dagi /tmp'ga tegishi yo'q.
PrivateTmp=true
ReadWritePaths=/var/backups/efbazaar /var/run/docker.sock /opt/efbazaar
