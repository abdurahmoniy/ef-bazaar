# Backend auth-service (internal, server-side fetch — nginx orqali)
# Server (Next.js Node runtime) ichida ishlatiladi.
INTERNAL_API_BASE_URL=http://nginx/api

# Telegram bot username (Login Widget uchun)
NEXT_PUBLIC_TELEGRAM_BOT=EfBazaarBot

# Telegram bot numeric ID — bot tokenning ":" gacha bo'lgan qismi.
# Logout'dan keyin "Boshqa nomer bilan kirish" popup'i uchun ishlatiladi
# (Telegram.Login.auth API bot_id'ni majburiy talab qiladi).
NEXT_PUBLIC_TELEGRAM_BOT_ID=

# Google OAuth Client ID (browser GIS init + backend audience tekshiruvi)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public base URL (frontend canonical)
NEXT_PUBLIC_BASE_URL=https://efbazaar.chempox.uz
