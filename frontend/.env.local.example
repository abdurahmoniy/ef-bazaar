# Backend auth-service (internal, server-side fetch — nginx orqali)
# Server (Next.js Node runtime) ichida ishlatiladi.
INTERNAL_API_BASE_URL=http://nginx:8080/api

# Local chat WebSocket setup (authenticated nginx proxy and backend origin opt-in):
# See docs/superpowers/plans/2026-09-25-chat-websocket.md.
# CHAT_WEBSOCKET_ALLOWED_ORIGINS belongs to the backend/root environment, not this file.

# Telegram bot username (Login Widget uchun)
NEXT_PUBLIC_TELEGRAM_BOT=EfBazaarBot

# Rasmiy ijtimoiy tarmoqlar
NEXT_PUBLIC_TELEGRAM_CHANNEL=efbazaar
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/efbazaar.uz

# Google OAuth Client ID (browser GIS init + backend audience tekshiruvi)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public base URL (frontend canonical)
NEXT_PUBLIC_BASE_URL=https://efbazaar.uz

# Firebase Web Push (public web-app values, read at server runtime)
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
