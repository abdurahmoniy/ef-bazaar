# ==============================================================
# efBazaar — Environment variables
# Copy to .env va qiymatlarni to'ldiring. .env hech qachon git ga tushmasin.
# Production: GitHub Secrets dan deploy paytida hosil bo'ladi.
# ==============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=efbazaar
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Har bir servis uchun alohida DB (init script avtomatik yaratadi)
AUTH_DB_NAME=auth_db
MARKETPLACE_DB_NAME=marketplace_db
RECOMMENDATION_DB_NAME=recommendation_db
TRADE_DB_NAME=trade_db
PAYMENT_DB_NAME=payment_db
ACCESS_DB_NAME=access_db
# Player cards (efhub.com manbasidan scrape qilingan ma'lumotlar uchun)
EFBAZAAR_DB_NAME=efbazaar

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# Card-interest identities are HMAC-pseudonymized before Redis storage.
# Generate independently from JWT_SECRET: openssl rand -base64 48
CARD_INTEREST_HMAC_SECRET=change_me_to_random_card_interest_secret

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---------- Auth Service ----------
# JWT secret faqat auth-service da. Minimum 32 byte random.
# Yaratish:  openssl rand -base64 48
JWT_SECRET=change_me_to_random_min_32_bytes_base64_string
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Server-to-server shared secret — barcha /internal/** endpointlar uchun:
#   - auth-service (names/summary batch)
#   - marketplace-service (Chempionat-X trust bridge intake)
#   - nginx /api/tournaments route (X-Internal-Secret sifatida Chempionat'ga uzatadi)
# Chempionat-X .env dagi EFBAZAAR_INTERNAL_SECRET BILAN BIR XIL bo'lishi SHART.
# Yaratish:  openssl rand -base64 32
INTERNAL_API_SECRET=change_me_to_random_secret

# ---------- Telegram Bot ----------
# @BotFather dan olinadi (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Bot a'zo bo'lgan forum-style supergroup chat ID.
# https://t.me/c/<NNNN>/<topic_id>  →  TELEGRAM_GROUP_CHAT_ID=-100<NNNN>
TELEGRAM_GROUP_CHAT_ID=

# Topic (message_thread_id) — group ichidagi forum topiklari
TELEGRAM_TOPIC_LOGS=6           # ERROR + WARN loglar
TELEGRAM_TOPIC_REGISTRATION=4   # Yangi user ro'yxati ma'lumotlari
TELEGRAM_TOPIC_MEDIA=2          # Account rasmlari (sendMediaGroup, 1-6 rasm)
# Hamyon to'ldirish (invoice) e'lonlari tushadigan topic thread_id.
# SIR — haqiqiy qiymat faqat .env da turadi, hech qachon git ga tushmaydi.
# Bo'sh qoldirilsa e'lon yuborilmaydi (General thread ga TUSHMAYDI) —
# to'ldirish esa ishlayveradi.
TELEGRAM_TOPIC_PAYMENTS=
TELEGRAM_TOPIC_EMAIL=
TELEGRAM_TOPIC_SUPPORT=         # Qo'llab-quvvatlash, hamkorlik va savollar guruhi topic thread_id

# ---------- Payment — admin e'lonlari ----------
# payment-service bot ga ichki tarmoq orqali murojaat qiladi; bot token va
# chat id payment-service da YO'Q.
BOT_INTERNAL_BASE_URL=http://bot:8084
PAYMENT_ADMIN_TELEGRAM_ENABLED=true

# Webhook URL (production — TLS shart). Local dev da long-polling ishlatamiz.
TELEGRAM_WEBHOOK_URL=
# Webhook secret token — Telegram har POST'da X-Telegram-Bot-Api-Secret-Token
# header'ida qaytaradi, bot shu bilan real Telegram'ni soxta chaqiruvlardan
# ajratadi. TELEGRAM_WEBHOOK_URL bo'sh bo'lsa ignore'lanadi. Generatsiya:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---------- Media yuklash ----------
# Listing rasmlariga cheklov
MEDIA_MIN_FILES=1
MEDIA_MAX_FILES=6
MEDIA_MAX_FILE_SIZE_MB=5
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif

# ---------- Network / Host ports ----------
# Nginx host port — agar serverda 80 boshqa app tomonidan band bo'lsa,
# bu yerga bo'sh port qo'ying (masalan 8090). Kontayner ichida har doim 80.
# Tashqaridan: http://server-ip:8090/
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---------- App ----------
# "mockworker" enables trade-service's MockWorker (stand-in for the Plan C
# Python smart-admin-worker) so the trade lifecycle can complete end-to-end
# without a real worker. Dev/staging: SPRING_PROFILES_ACTIVE=docker,mockworker
# Production: leave as just "docker" — MockWorker must never run in prod.
SPRING_PROFILES_ACTIVE=docker,mockworker
APP_BASE_URL=https://efbazaar.uz
# Legacy listings without normalized player-card inventory are repaired at
# marketplace-service startup. Safe to leave true: completed rows are skipped.
LISTING_CARD_BACKFILL_ENABLED=true

# "Akkountlarim" bo'limi uchun bir martalik ta'mir: har bir FAOL e'lon
# ortida akkount ochiladi. Qayta ishga tushirish xavfsiz — mavjud
# akkountlar o'tkazib yuboriladi. Ta'mir bajarilgach false qilsa bo'ladi.
USER_ACCOUNT_BACKFILL_ENABLED=true

# ---------- TLS / Swagger ----------
# Let's Encrypt notification email (init-cert.sh paytida)
LE_EMAIL=
# Swagger basic auth (init-cert.sh paytida htpasswd ga yoziladi)
SWAGGER_USER=admin
SWAGGER_PASS=

# ---------- Google OAuth ----------
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client ID
# Web application, authorized JS origins = https://efbazaar.uz
# (ID token flow — client_secret kerakmas, faqat client_id audience uchun)
GOOGLE_CLIENT_ID=

# ---------- Bot: ommaviy xabar ----------
# Telegram butun bot uchun sekundiga ~30 xabarga ruxsat beradi. Bu jilov
# faqat ommaviy jo'natishni sanaydi; chat bildirishnomalari va Telegramga
# ketadigan loglar ham shu byudjetdan yeydi, shuning uchun zaxira qoldirilgan.
BROADCAST_MESSAGES_PER_SECOND=20
# Har shuncha xabardan keyin borish holati marketplace'ga yuboriladi.
BROADCAST_PROGRESS_EVERY=50

# efBazaar rasmiy Telegram kanali — HAR BIR e'lon shu yerga ham tushadi.
# @username yoki raqamli id (masalan @EfBazaar yoki -1001234567890).
#
# QO'LDA TAHRIRLAMANG. deploy.sh har deployda .env ni bo'shatib CI
# secretlaridan qayta yozadi, ya'ni bu yerga yozilgan qiymat keyingi
# deployda jimgina yo'qoladi. Haqiqiy manba — GitHub repo secret
# OFFICIAL_CHANNEL.
#
# BO'SH QOLDIRILSA butunlay o'chiq: sozlanmagan muhit na yiqilishi, na
# noto'g'ri joyga post qilishi kerak. Jonli kanalga tushgan postni
# orqaga qaytarib bo'lmaydi.
#
# Bot bu kanalda ADMIN bo'lishi shart (post qo'yish, forward va
# sotilganda tahrirlash uchun).
OFFICIAL_CHANNEL=

# Kanal postidagi "E'lonni ochish" tugmasi shu havolaga boradi va e'lonni
# Mini App ichida ochadi (brauzerda emas). Post matnidagi "efBazaar"
# havolasi esa oddiy sayt havolasi bo'lib qolaveradi.
#
# Qisqa nom BotFather'da ochiladi: /newapp -> botni tanlash -> Web App URL
# https://efbazaar.uz -> short name (masalan "app").
#
# BO'SH QOLDIRILSA tugma eski sayt havolasiga tushadi — sozlanmagan
# muhitda tugma o'lik bo'lib qolmasligi uchun.
TELEGRAM_MINI_APP_URL=

NEXT_PUBLIC_TELEGRAM_CHANNEL=efbazaar
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/efbazaar.uz

# ---------- Grafana (dashboard.efbazaar.uz) ----------
# Grafana admin paroli. CI'da GRAFANA_ADMIN_PASSWORD secret'i sifatida
# turadi; berilmasa deploy.sh "admin" ga tushadi va dashboard ochiq
# domenda ekanini hisobga olsak, bu qabul qilib bo'lmaydi.
# Generatsiya qiling, o'ylab topmang: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Optional Firebase Web Push. Backend credentials stay server-side.
FIREBASE_PUSH_ENABLED=false
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
# Only needed when using frontend/docs/firebase-push.compose.yml.
FIREBASE_CREDENTIALS_FILE=
